{
  "title": "Alt + Left/Right Browser History Navigation",
  "rules": [
    {
      "description": "Remap Option + Left/Right to Cmd + [ / ] for Linux-style browser back/forward",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "key_code": "open_bracket",
              "modifiers": ["command"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "key_code": "close_bracket",
              "modifiers": ["command"]
            }
          ]
        }
      ]
    }
  ]
}
